# Copy this file to ".env" and fill it in. Never share your .env file: the token controls the bot.
# To copy IDs, turn on Developer Mode first: Discord Settings > Advanced > Developer Mode.

# Bot token: https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_TOKEN=

# The STAFF server's ID (right-click the server icon > Copy Server ID)
STAFF_GUILD_ID=

# The channel in the staff server where the bot pings whoever's turn it is
# (right-click the channel > Copy Channel ID)
STAFF_CHANNEL_ID=

# ID of the "Daily Questions Ping" role in the MAIN DDL server. This makes the template's
# role mention work when it's pasted into the main server.
# To get it: in the main server, click someone who has the role, right-click the role on their profile > Copy Role ID.
# Leave blank to show plain "@Daily Questions Ping" text in the template instead.
QOTD_ROLE_ID=

# When to ping each day (24-hour HH:MM) and the timezone for that time.
# Timezone names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/Chicago, America/New_York, America/Los_Angeles, Europe/London
PING_TIME=08:00
TIMEZONE=America/Chicago

# Optional: a staff-server role that can manage the rotation (add, remove, set-number...).
# Anyone with the Manage Server permission can always manage it.
MANAGER_ROLE_ID=
